 "content": {
  "pages": [
   {
    "id": "home",
    "slug": "home",
    "status": "published",
    "data": {
     "title": "OpenBox for Agentforce",
     "header_cta_label": "Become a design partner",
     "header_cta_url": "#partner",
     "launchpad_label": "Salesforce Launchpad member",
     "footer_note": "OpenBox for Salesforce Agentforce. Mockup for design-partner outreach — product screens are illustrative.",
     "content": [
      {
       "anchor_id": "top",
       "badge": "OpenBox for Salesforce Agentforce",
       "headline": "Agentforce agents that can’t be talked out of your rules.",
       "highlight": "talked out of your rules.",
       "lede": "OpenBox puts a security checkpoint in front of every message and every action an Agentforce agent takes. Salesforce writes nothing until OpenBox says yes — and nothing at all if OpenBox can’t be reached.",
       "primary_cta_label": "Become a design partner",
       "primary_cta_url": "#partner",
       "secondary_cta_label": "See it work (2 min)",
       "secondary_cta_url": "#watch",
       "checks": [
        {
         "text": "Installs into your org"
        },
        {
         "text": "Fails closed by default"
        },
        {
         "text": "Every decision on the record"
        }
       ],
       "audience_note": "Built for security, RevOps & Salesforce teams putting Agentforce into production — especially in regulated industries.",
       "audience_bold": "security, RevOps & Salesforce teams",
       "sim_default": 45,
       "sim_constrain_above": 15,
       "sim_approval_above": 25,
       "sim_block_above": 40,
       "sim_halt_at": 90,
       "_type": "agf_hero",
       "_version": 1,
       "_key": "hero"
      },
      {
       "items": [
        {
         "title": "Native package",
         "text": "Installs into Salesforce. No middleware to host.",
         "icon": "package"
        },
        {
         "title": "Fails closed",
         "text": "No answer means nothing is written. Ever.",
         "icon": "shield-tick"
        },
        {
         "title": "Tamper-proof trail",
         "text": "Every decision becomes a record you can report on.",
         "icon": "file-check"
        },
        {
         "title": "Launchpad member",
         "text": "Built on the Salesforce partner platform.",
         "icon": "cloud"
        }
       ],
       "_type": "agf_trust",
       "_version": 1,
       "_key": "trust"
      },
      {
       "anchor_id": "watch",
       "eyebrow": "Watch it in action",
       "heading": "See OpenBox govern Agentforce in 2 minutes",
       "text": "A short walkthrough: the agent proposes a change, OpenBox decides, and Salesforce writes only what’s allowed.",
       "duration": "2:00",
       "caption": "Captions available ·",
       "transcript_label": "Read the transcript",
       "transcript_url": "#",
       "_type": "agf_video",
       "_version": 1,
       "_key": "video"
      },
      {
       "heading": "Prompt instructions are not a security boundary.",
       "text": "Tell an agent “never change a record without approval” and a clever user, a manipulated prompt or a confused model can still get it to. OpenBox moves the rule out of the prompt and into Salesforce code the agent cannot skip.",
       "_type": "agf_statement",
       "_version": 1,
       "_key": "statement"
      },
      {
       "anchor_id": "how",
       "eyebrow": "How it works",
       "heading": "A checkpoint between the agent and your data",
       "text": "Salesforce calls OpenBox directly over HTTPS before anything is written. Four steps, every single request.",
       "steps": [
        {
         "title": "User asks",
         "text": "A person asks the agent to do something — raise a limit, update a record, run a flow.",
         "icon": "user"
        },
        {
         "title": "Agent proposes",
         "text": "Agentforce reasons and proposes an action, reading the record as that user — so it sees only what they may see.",
         "icon": "message"
        },
        {
         "title": "OpenBox decides",
         "text": "Every message and action is checked against your policy — the rule that lives in OpenBox, not in the prompt.",
         "icon": "shield-tick",
         "checkpoint": true
        },
        {
         "title": "Salesforce writes",
         "text": "Only what OpenBox allows is written — and Salesforce re-checks the user’s own access on top.",
         "icon": "cloud"
        }
       ],
       "note_lead": "No answer from OpenBox?",
       "note_text": "Nothing is written. A timeout, a malformed reply or a failed identity check all fail closed.",
       "_type": "agf_steps",
       "_version": 1,
       "_key": "steps"
      },
      {
       "anchor_id": "decisions",
       "eyebrow": "Every request gets one of five decisions",
       "heading": "Five verdicts, every one explained",
       "text": "OpenBox never just says no. Each outcome comes back with a reason the agent can pass to the user, and is logged for the audit trail.",
       "verdicts": [
        {
         "verdict": "ALLOW",
         "description": "Runs now, after Salesforce re-checks the user’s own access."
        },
        {
         "verdict": "CONSTRAIN",
         "description": "Runs, but inside limits. The action is capped to what your policy allows."
        },
        {
         "verdict": "REQUIRE APPROVAL",
         "description": "Waits for a person. Nothing changes until it’s approved."
        },
        {
         "verdict": "BLOCK",
         "description": "Doesn’t run. The agent is told why and can explain it to the user."
        },
        {
         "verdict": "HALT",
         "description": "Doesn’t run, and the conversation is ended."
        }
       ],
       "example_eyebrow": "Illustrative example · a sales agent",
       "example_title": "The rule lives in code, not in the prompt",
       "example_text": "Drag the slider in the hero and this is the policy it runs against.",
       "example_steps": [
        {
         "text": "A user asks the agent to put a 45% discount on an opportunity.",
         "bold": "45% discount"
        },
        {
         "text": "Salesforce reads the record as that user, so the agent sees only what they may see."
        },
        {
         "text": "OpenBox checks the request against your policy. At 45% the rule blocks the write, so nothing changes.",
         "bold": "blocks the write"
        },
        {
         "text": "A smaller ask is handled too: 20% is capped to 15% (CONSTRAIN), 30% waits for approval. Every outcome is explained, and both sides keep the audit trail.",
         "bold": "CONSTRAIN"
        }
       ],
       "code": "# the rule lives in OpenBox, not in the prompt\naction opportunity.update_discount\n\n  if discount > 40%   → BLOCK\n  if discount > 25%   → REQUIRE_APPROVAL\n  if discount > 15%   → CONSTRAIN  # capped to 15%\n  else                → ALLOW",
       "footnote_lead": "Discounts are only the demo.",
       "footnote_text": "The same checkpoint covers any field on any object, and any flow, action or Apex class you route through it: credit limits, refunds, case priority, customer data.",
       "_type": "agf_verdicts",
       "_version": 1,
       "_key": "verdicts"
      },
      {
       "anchor_id": "demo",
       "eyebrow": "See it live",
       "heading": "Set the rules once. The agent tries. OpenBox decides.",
       "text": "The four moments from the 2-minute walkthrough — a credit agent asked to raise a limit — with every decision ending up on the record.",
       "slide1_tab": "Policy",
       "slide1_title": "The policy",
       "slide1_sub": "Set the rules once in OpenBox — versioned, with no Salesforce release",
       "slide1_url": "openbox.node.ai/agents/credit-agent/policies",
       "rules": [
        {
         "text": "Credit limit of $5M or more halts the credit agent",
         "verdict": "HALT"
        },
        {
         "text": "No credit increases for Cold-rated accounts",
         "verdict": "BLOCK"
        },
        {
         "text": "Credit limits above $1M are blocked for agents",
         "verdict": "BLOCK"
        },
        {
         "text": "Credit increases above $50K need credit-team approval",
         "verdict": "REQUIRE APPROVAL"
        }
       ],
       "slide1_caption": "Policies live in OpenBox and are versioned — commit 732130a. Editing a rule here takes effect on the next request, with no Salesforce release.",
       "slide1_caption_mono": "commit 732130a",
       "slide2_tab": "Agent",
       "slide2_title": "The agent tries",
       "slide2_sub": "The agent asks; OpenBox returns a verdict with a reason it can share",
       "slide2_url": "openbox.node.ai/agents/credit-agent/conversations",
       "messages": [
        {
         "from": "user",
         "text": "Raise the credit limit on Northwind Retail to $6,000,000."
        },
        {
         "from": "agent",
         "verdict": "HALT",
         "text": "I can’t do that. A credit limit of $5M or more is treated as abuse, so this session is ended for review."
        },
        {
         "from": "user",
         "text": "New session — set Northwind Retail’s credit limit to $350,000."
        },
        {
         "from": "agent",
         "verdict": "REQUIRE APPROVAL",
         "text": "That’s above the $50K agent threshold, so I’ve sent it to the credit team. Nothing changes until a person approves it."
        },
        {
         "from": "agent",
         "verdict": "ALLOW",
         "text": "Approved by the credit team. Northwind Retail’s credit limit is now $350,000."
        }
       ],
       "slide2_caption": "The agent never argues its way past a rule. Each verdict comes back with a reason it can hand to the user.",
       "slide3_tab": "Record",
       "slide3_title": "The record updates",
       "slide3_sub": "The approved change is written once, inside your org",
       "slide3_url": "northwind.lightning.force.com/Account/Northwind-Retail",
       "record": [
        {
         "label": "Account Name",
         "value": "Northwind Retail"
        },
        {
         "label": "Industry",
         "value": "Retail"
        },
        {
         "label": "Annual Revenue",
         "value": "$12,000,000"
        },
        {
         "label": "Account Rating",
         "value": "Warm"
        },
        {
         "label": "Credit Limit",
         "value": "$350,000",
         "old_value": "$275,000",
         "highlight": true
        },
        {
         "label": "Last Modified By",
         "value": "OpenBox Sales Agent · 11/2/2026"
        }
       ],
       "slide3_caption": "The approved change is written once, inside your org. No one had to go back and ask — the record shows exactly what changed and who changed it.",
       "slide4_tab": "Audit",
       "slide4_title": "The audit trail",
       "slide4_sub": "Every decision logged as a Governed Request you can report on",
       "slide4_url": "openbox.node.ai/agents/credit-agent/issues",
       "issues": [
        {
         "title": "Blocked: a credit limit of $5M or more is treated as abuse; the agent session is halted",
         "meta": "AccountCreditLimitUpdate · salesforce-conversation-00DAs…2176c4 · 14 hours ago"
        },
        {
         "title": "Blocked: credit limits above $1M must be set by the credit committee, not an agent",
         "meta": "AccountCreditLimitUpdate · salesforce-conversation-00DAs…0c3cde1 · 14 hours ago"
        },
        {
         "title": "Blocked: accounts rated Cold cannot have their credit limit raised by an agent",
         "meta": "AccountCreditLimitUpdate · salesforce-conversation-00DAs…5f8edb8 · 14 hours ago"
        },
        {
         "title": "Blocked: credit limit increases above $50K require credit-team approval",
         "meta": "AccountCreditLimitUpdate · salesforce-conversation-00DAs…22b9313 · 15 hours ago"
        }
       ],
       "slide4_caption": "Every decision shows up in OpenBox, and every write becomes a Governed Request record inside Salesforce — report on it like any other object.",
       "_type": "agf_demo",
       "_version": 1,
       "_key": "demo"
      },
      {
       "anchor_id": "proof",
       "eyebrow": "Why it holds",
       "heading": "Built for security teams in regulated industries",
       "text": "OpenBox adds runtime rules, approvals and tamper-proof evidence on top of the permissions and sharing your org already enforces. It never loosens them.",
       "items": [
        {
         "title": "Both systems must agree",
         "text": "Salesforce re-checks the user’s access on every write."
        },
        {
         "title": "Fails closed",
         "text": "No answer, a timeout or a bad reply means no write."
        },
        {
         "title": "One path to protected fields",
         "text": "Flows and API clients can’t bypass OpenBox."
        },
        {
         "title": "No stale or repeated writes",
         "text": "Changed records are refused; approvals run once."
        },
        {
         "title": "Your data stays put",
         "text": "OpenBox never calls into your org."
        },
        {
         "title": "No secrets in code",
         "text": "Keys stay in Salesforce credentials."
        }
       ],
       "cards": [
        {
         "title": "Native to your org",
         "text": "A package that installs into Salesforce. Nothing to host, and no middleware — Salesforce calls OpenBox directly over HTTPS.",
         "icon": "package"
        },
        {
         "title": "Covers what you already built",
         "text": "Flows, standard actions and your own Apex run only after OpenBox says yes. Registering a flow takes no code.",
         "icon": "layers"
        },
        {
         "title": "Rules change without a release",
         "text": "Policies, guardrails and approvers are edited in OpenBox, and the next request follows them.",
         "icon": "sliders"
        }
       ],
       "closing_lead": "It works with Salesforce, not around it.",
       "closing_text": "OpenBox adds your runtime rules, approvals and tamper-proof evidence on top of the permissions and sharing your org already enforces. It never loosens them, and if OpenBox is ever unreachable the write simply does not happen.",
       "_type": "agf_proof",
       "_version": 1,
       "_key": "proof"
      },
      {
       "anchor_id": "faq",
       "eyebrow": "Questions security teams ask",
       "heading": "FAQ",
       "items": [
        {
         "question": "Does OpenBox see our Salesforce data?",
         "answer": "No. OpenBox never calls into your org. Salesforce sends only the specific facts a decision needs, and personal fields can be redacted before they leave."
        },
        {
         "question": "What happens if OpenBox is unreachable?",
         "answer": "The write doesn’t happen. A timeout, a malformed reply or a failed identity check all fail closed — nothing is written until OpenBox returns a valid decision."
        },
        {
         "question": "Is this middleware we have to host?",
         "answer": "No. It’s an unlocked package that installs into your org. Salesforce calls OpenBox directly over HTTPS; there’s nothing for you to run or maintain."
        },
        {
         "question": "Does it replace Salesforce permissions?",
         "answer": "It adds to them. An OpenBox “yes” still has to pass the user’s own object, field and record access in Salesforce. OpenBox never loosens what your org already enforces."
        },
        {
         "question": "Do we need to rebuild our flows and Apex?",
         "answer": "No. Flows, standard actions and your own Apex run only after OpenBox says yes. Registering a flow takes no code."
        },
        {
         "question": "How do we change a rule?",
         "answer": "Policies, guardrails and approvers are edited in OpenBox and versioned. The next request follows the new rule — no Salesforce release required."
        }
       ],
       "_type": "agf_faq",
       "_version": 1,
       "_key": "faq"
      },
