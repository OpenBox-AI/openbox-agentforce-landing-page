{
  "name": "openbox-agentforce-landing-page",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Starter",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
