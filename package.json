    "start:node": "node ./dist/server/entry.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "^1.4.0",
    "astro": "^7.3.2",
    "emdash": "^1.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261109.1",
    "wrangler": "^4.159.0"
  }
