{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openbox-agentforce-landing-page",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// The D1 database is created on the first `wrangler deploy` if it doesn't exist.
	// The R2 bucket is NOT auto-created: create `openbox-agentforce-media` in the SAME Cloudflare
	// account that runs the build (R2 → Create bucket) before deploying, or the deploy fails with code 10085.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openbox-agentforce-landing-page",
		},
	],
	// Session store. Pinned to the existing namespace so deploys don't try to re-create it (error 10014).
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "e7e416e84f2e446db44259d31d99bb58",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "openbox-agentforce-media",
		},
	],
	// Cron trigger drives scheduled publishing and maintenance.
	"triggers": {
		"crons": ["* * * * *"],
	},
}
