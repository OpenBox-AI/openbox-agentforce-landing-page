---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Blocks } from "emdash/ui";
import { landingComponents } from "../components/blocks";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
// The home entry is served at "/" (see index.astro). Send /home there so the page has a single URL.
if (slug === "home") return Astro.redirect("/", 301);

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
	headerCtaLabel={page.data.header_cta_label}
	headerCtaUrl={page.data.header_cta_url}
	launchpad={page.data.launchpad_label}
	footerNote={page.data.footer_note}
>
	<Blocks value={page.data.content} components={landingComponents} />
</Base>
