---
import Icon from "../Icon.astro";
const { value: v } = Astro.props;
const editions = (v.edition_options ?? "").split("\n").map((x: string) => x.trim()).filter(Boolean);
---

<section class="band" style="padding-top: 8px" id={v.anchor_id || undefined}>
	<div class="wrap">
		<div class="partner">
			<div class="partner__copy">
				{v.eyebrow && <span class="eyebrow">{v.eyebrow}</span>}
				<h2 class="h2">{v.heading}</h2>
				{v.text && <p class="lead">{v.text}</p>}
			</div>
			<form class="form" data-partner-form data-email={v.email} novalidate>
				<div class="fld">
					<label for="pf-email">Work email *</label>
					<input id="pf-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
					<span class="err"><Icon name="alert" />Enter a work email, like name@company.com</span>
				</div>
				<div class="fld">
					<label for="pf-edition">Salesforce edition</label>
					<select id="pf-edition" name="edition">
						<option value="">Select your edition</option>
						{editions.map((e: string) => <option>{e}</option>)}
					</select>
				</div>
				<div class="fld">
					<label for="pf-action">The one action you’d least want an agent to get wrong</label>
					<textarea id="pf-action" name="action" placeholder="e.g. raising a customer credit limit"></textarea>
				</div>
				<button class="btn btn--primary btn--block" type="submit">{v.form_cta || "Request a design-partner spot"}<Icon name="arrow-right" /></button>
				<p class="form__ok" data-form-ok hidden>Opening your email app with your details…</p>
				{v.form_note && <p class="form__note">{v.form_note}</p>}
			</form>
		</div>
	</div>
</section>
