---
import Icon from "../Icon.astro";
const { value: v } = Astro.props;
const items = v.items ?? [];
---

<section class="band band--grid" id={v.anchor_id || undefined}>
	<div class="wrap">
		<div class="head">
			{v.eyebrow && <span class="eyebrow">{v.eyebrow}</span>}
			<h2 class="h2">{v.heading}</h2>
		</div>
		<div class="faq">
			{items.map((q: any, i: number) => (
				<details class="q" open={i === 0}>
					<summary>{q.question}<Icon name="plus" class="plus" /><Icon name="minus" class="minus" /></summary>
					<p>{q.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>
