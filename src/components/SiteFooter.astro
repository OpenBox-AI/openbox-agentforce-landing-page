---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

interface Item {
	label: string;
	url: string;
	target?: string;
}
interface Props {
	links: Item[];
	legal: Item[];
	note?: string | null;
	launchpad?: string | null;
}
const { links, legal, note, launchpad } = Astro.props;
---

<footer class="foot">
	<div class="wrap">
		<div class="foot__row">
			<a href="/" class="foot__logo" aria-label="OpenBox home"><Logo /></a>
			<nav class="foot__links" aria-label="Footer">
				{links.map((i) => <a href={i.url} target={i.target} rel={i.target === "_blank" ? "noopener noreferrer" : undefined}>{i.label}</a>)}
			</nav>
		</div>
		{launchpad && <p><span class="pill"><Icon name="cloud" />{launchpad}</span></p>}
		{note && <p>{note}</p>}
		<div class="foot__legal">
			<span>&copy; {new Date().getFullYear()} OpenBox AI. All rights reserved.</span>
			{legal.map((i) => <a href={i.url}>{i.label}</a>)}
		</div>
	</div>
</footer>
